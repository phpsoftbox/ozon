{
    "name": "phpsoftbox/ozon",
    "description": "Ozon API client component for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "^8.5",
        "phpsoftbox/collection": "dev-master",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpsoftbox/cli-app": "dev-master",
        "phpsoftbox/code-generator": "dev-master",
        "phpsoftbox/cs-fixer": "^1.2.1",
        "phpsoftbox/http-message": "dev-master",
        "phpunit/phpunit": "^13.3"
    },
    "suggest": {
        "phpsoftbox/cli-app": "Required for the ozon:openapi:generate-dto DTO generator command (maintainer tooling).",
        "phpsoftbox/code-generator": "Required for DTO generation from OpenAPI (maintainer tooling)."
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Ozon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Ozon\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
